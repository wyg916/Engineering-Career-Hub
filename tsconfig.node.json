{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/core/**/*.ts",
    "src/shared/**/*.ts",
    "tests/core/**/*.ts",
    "tests/main/**/*.ts",
    "vitest.config.ts",
    "electron.vite.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@core/*": ["src/core/*"]
    }
  }
}
